# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RukZa's Fashion Hub"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-change-in-production"

# Private Admin Panel (ONLY YOU — never commit real values)
# Option A (recommended on Vercel): bcrypt hash — run: node scripts/hash-admin-password.mjs "YourPassword"
ADMIN_PASSWORD_HASH=""
# Option B: plain password in env only (local dev or Vercel — never in GitHub)
ADMIN_PASSWORD="ChangeThisToYourOwnPassword123"
ADMIN_SECRET="your-admin-secret-change-in-production"

# WhatsApp order alerts (your private number — never commit real values)
# Example: 971501234567 (country code + number, no + or spaces)
WHATSAPP_NOTIFY_PHONE=""
# Optional: for automatic WhatsApp messages (free setup at https://www.callmebot.com)
CALLMEBOT_API_KEY=""

# Optional: auto-added when you connect Vercel Blob to the project (required for live admin updates on Vercel)
# BLOB_READ_WRITE_TOKEN=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Meta / Facebook (Stage 2)
META_APP_ID=""
META_APP_SECRET=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# Cloudinary / image storage (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
